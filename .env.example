# 商汤小浣熊 Raccoon2api 配置文件示例
# 复制为 .env 即可生效：
# cp .env.example .env

# 服务监听端口（默认 8790）
PORT=8790

# 可选手动指定 JWT Token (默认从本地小浣熊桌面端自动读取，无需配置)：
# RACCOON_ACCESS_TOKEN=eyJhbGciOiJSUzI1Ni...

# 可选自定义 auth.json 本地路径 (默认自动探测 macOS/Windows/Linux)：
# RACCOON_AUTH_FILE=/path/to/office-raccoon/agent/config/auth.json

# 可选自定义小浣熊官方服务地址：
RACCOON_UPSTREAM_URL=https://xiaohuanxiong.com
